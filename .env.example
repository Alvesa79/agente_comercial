# ==== Servidor ====
PORT=3000
# Secreto para verificar la firma de Meta (header X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Token de verificación del webhook (lo eliges tú, Meta lo envía en GET)
WHATSAPP_VERIFY_TOKEN=mi-token-de-verificacion
# Token de acceso de la app Meta (para enviar respuestas)
WHATSAPP_TOKEN=
# Número de teléfono del negocio (opcional, solo informativo)
WHATSAPP_PHONE_NUMBER_ID=

# ==== Odoo (JSON-RPC) ====
# Ej: https://miempresa.odoo.com
ODOO_URL=
ODOO_DB=
ODOO_EMAIL=
ODOO_API_KEY=
# Equipo de ventas (opcional): su líder recibe los leads de contactos nuevos
ODOO_TEAM_ID=

# ==== Estado persistente ====
# Archivo donde se guardan sesiones, idempotencia y cola de leads
STATE_FILE=.data/state.json
# Cada cuánto se reintentan los leads encolados (ms)
OUTBOX_INTERVAL_MS=60000

# ==== LLM (opcional; sin esto se usa el parser de reglas) ====
# Endpoint compatible con OpenAI: ej https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
